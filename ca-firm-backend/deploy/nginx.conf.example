# Nginx reverse proxy in front of the Node app (which listens on PORT,
# default 5000, per .env). Nginx handles TLS; Node never needs to.
#
# 1. Copy this to /etc/nginx/sites-available/antexis, edit the domain name
# 2. sudo ln -s /etc/nginx/sites-available/antexis /etc/nginx/sites-enabled/
# 3. sudo nginx -t && sudo systemctl reload nginx
# 4. sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
#    (certbot rewrites this file to add the HTTPS server block automatically)

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Uploaded files (resumes, blog images/docs) served directly by Node,
    # proxied the same as everything else — no special-casing needed.
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 10M;
}
