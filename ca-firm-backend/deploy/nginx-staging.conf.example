# Staging site on the SAME VPS as production — a different subdomain
# proxying to a different port, so it's fully separate at the application
# level while costing nothing extra to host.
#
# 1. Add a DNS A record: staging.yourdomain.com -> same VPS IP as production
# 2. Copy this to /etc/nginx/sites-available/antexis-staging
# 3. sudo ln -s /etc/nginx/sites-available/antexis-staging /etc/nginx/sites-enabled/
# 4. sudo nginx -t && sudo systemctl reload nginx
# 5. sudo certbot --nginx -d staging.yourdomain.com   (separate free cert)

server {
    listen 80;
    server_name staging.yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 10M;
}
